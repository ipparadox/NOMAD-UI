# Dedicated i3 configuration for the NOMAD GDM session.
# This file is intentionally separate from ~/.config/i3/config.

set $mod Mod4

font pango:monospace 8
focus_follows_mouse no
focus_on_window_activation smart

default_border pixel 0
default_floating_border pixel 0
hide_edge_borders both

# NOMAD remains the sole tiled desktop window. Managed applications float
# above it and are positioned by src/classes/i3WindowManager.class.js.
for_window [class="^eDEX-UI$" instance="^edex-ui$"] fullscreen disable, border pixel 0
# This dedicated session contains only NOMAD and applications launched for its
# registry. Exact ownership is still decided by I3WindowManager; this generic
# rule prevents a newly mapped application from briefly tiling the HUD.
for_window [class="^(?!eDEX-UI$).+$"] floating enable, border pixel 0

# No bar block is defined: the NOMAD session has no visible i3 chrome.

# Start the UI only after i3 and its IPC socket are ready.
exec --no-startup-id /usr/local/bin/nomad-session --launch-ui

# Emergency return to GDM. This binding is deliberately not shown in the UI.
bindsym $mod+Shift+Escape exit
