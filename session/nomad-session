#!/usr/bin/env bash

set -u
umask 077

readonly NOMAD_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nomad"
readonly NOMAD_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nomad"
readonly NOMAD_SESSION_LOG="$NOMAD_STATE_DIR/session.log"
readonly NOMAD_UI_LOG="$NOMAD_STATE_DIR/ui.log"

mkdir -p "$NOMAD_STATE_DIR"

log() {
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >>"$NOMAD_SESSION_LOG"
}

stop_session() {
    log "NOMAD-UI stopped; ending the NOMAD session"
    i3-msg exit >>"$NOMAD_SESSION_LOG" 2>&1 || true
}

launch_ui() {
    local nomad_root="${NOMAD_ROOT:-$HOME/Projects/NOMAD-UI}"
    local nvm_dir="${NVM_DIR:-$HOME/.nvm}"

    if [[ -e "$NOMAD_CONFIG_DIR/session.env" || -L "$NOMAD_CONFIG_DIR/session.env" ]]; then
        local env_permissions=""
        env_permissions="$(stat -c '%A' -- "$NOMAD_CONFIG_DIR/session.env" 2>/dev/null || true)"
        if [[ -L "$NOMAD_CONFIG_DIR/session.env" || ! -f "$NOMAD_CONFIG_DIR/session.env" \
            || ! -O "$NOMAD_CONFIG_DIR/session.env" || ! -r "$NOMAD_CONFIG_DIR/session.env" \
            || "${env_permissions:5:1}" == "w" || "${env_permissions:8:1}" == "w" ]]; then
            log "Refusing unsafe session.env; using default session paths"
        else
            # This verified user-owned regular file contains optional shell syntax.
            # shellcheck source=/dev/null
            source "$NOMAD_CONFIG_DIR/session.env"
            nomad_root="${NOMAD_ROOT:-$nomad_root}"
            nvm_dir="${NVM_DIR:-$nvm_dir}"
        fi
    fi

    exec >>"$NOMAD_UI_LOG" 2>&1
    log "Starting NOMAD-UI from $nomad_root"

    if [[ ! -f "$nomad_root/package.json" ]]; then
        log "NOMAD root is invalid: $nomad_root"
        stop_session
        return 1
    fi
    if [[ ! -s "$nvm_dir/nvm.sh" ]]; then
        log "NVM was not found at $nvm_dir/nvm.sh"
        stop_session
        return 1
    fi

    export NVM_DIR="$nvm_dir"
    export NOMAD_PRODUCTION=1
    unset NODE_OPTIONS NODE_PATH ELECTRON_RUN_AS_NODE BASH_ENV ENV
    # shellcheck source=/dev/null
    source "$NVM_DIR/nvm.sh"
    if ! nvm use 14; then
        log "The legacy Node 14 runtime is not installed in NVM"
        stop_session
        return 1
    fi

    cd "$nomad_root" || {
        log "Could not enter NOMAD root: $nomad_root"
        stop_session
        return 1
    }

    npm start
    status=$?
    log "NOMAD-UI exited with status $status"
    stop_session
    return "$status"
}

start_session() {
    local config="$NOMAD_CONFIG_DIR/i3/config"

    exec >>"$NOMAD_SESSION_LOG" 2>&1
    log "Starting NOMAD session"

    if ! command -v i3 >/dev/null 2>&1; then
        log "i3 is not installed"
        return 1
    fi
    if [[ ! -r "$config" ]]; then
        log "Dedicated i3 configuration is missing: $config"
        return 1
    fi

    export XDG_CURRENT_DESKTOP=NOMAD
    export XDG_SESSION_DESKTOP=NOMAD
    export DESKTOP_SESSION=nomad
    exec i3 -c "$config"
}

case "${1:-}" in
    --launch-ui)
        launch_ui
        ;;
    "")
        start_session
        ;;
    *)
        log "Unknown launcher argument: $1"
        exit 2
        ;;
esac
